"value": "111"}, {"key": "reminders_enabled", "value": "1"}], "bot_messages": [{"key": "welcome", "text": "Assalomu alaykum {first_name}, Inventor innovation centerga xush kelibsiz! Qanday yordam bera olaman? Agar kursda o'qimoqchi bo'lsangiz, kurslardan birini tanlang:\n1. Kompyuter savodxonlik\n2. Buxgalteriya 0 dan\n3. Glavbuxgalteriya\n4. Trading\n5. Sun'iy intellekt\n\nKursni tanlash uchun quyidagi tugmalardan birini bosing yoki raqamini yozing.", "updated_at": "2026-11-08T17:16:39.778119"}, {"key": "after_course", "text": "Javobingiz uchun rahmat! Ismingizni yozib qoldiring.", "updated_at": "2026-11-08T17:16:39.778119"}, {"key": "after_name", "text": "Telefon raqamingizni qoldiring, admin tez orada aloqaga chiqadi.", "updated_at": "2026-11-08T17:16:39.778119"}, {"key": "after_phone", "text": "Kechirasiz, telefon raqamini tushunmadim. Iltimos, raqamni quyidagi formatlardan birida yuboring: +998901234567, 998901234567 yoki 901234567.", "updated_at": "2026-11-08T17:16:39.778119"}, {"key": "name_invalid", "text": "Kechirasiz, ismni to'g'ri yozing (2 dan 50 gacha harf, raqam va havolasiz).", "updated_at": "2026-11-08T17:16:39.778119"}, {"key": "name_edited", "text": "Ismingiz tahrirlandi ✅ Endi telefon raqamingizni yuboring.", "updated_at": "2026-11-08T17:16:39.778119"}, {"key": "finish", "text": "Rahmat! Ma'lumotlaringiz qabul qilindi, admin tez orada bog'lanadi.", "updated_at": "2026-11-08T17:16:39.778119"}, {"key": "out_of_hours", "text": "Hozir ish vaqtimiz tugagan, ertaga javob beramiz.", "updated_at": "2026-11-08T17:16:39.778119"}], "ai_settings": [{"key": "style_prompt", "text": "Har doim juda rasmiy va qisqa javob bering.", "updated_at": "2026-11-08T21:56:02.471003"}, {"key": "extra_knowledge", "text": "Sinov narxi: 1 so'm.", "updated_at": "2026-11-08T21:56:02.479208"}], "message_templates": [{"key": "sinov_taklif", "title": "Sinov darsiga taklif", "text": "{ism}, sizni \"{kurs}\" kursiga sinov darsiga taklif qilamiz! Sana va vaqtni kelishib olamiz — qiziqqan bo'lsangiz javob yozing.", "updated_at": "2026-11-08T19:53:34.217392"}, {"key": "narxlar", "title": "Narxlar", "text": "{ism}, \"{kurs}\" kursining oylik narxi {summa}. Qo'shimcha savollar bo'lsa bemalol yozing!", "updated_at": "2026-11-08T21:56:06.055618"}, {"key": "guruh_toldi", "title": "Guruh to'ldi", "text": "{ism}, afsuski \"{guruh}\" guruhi to'lgan. Sizni navbatga yozdik — o'rin bo'shash bilanoq xabar beramiz.", "updated_at": "2026-11-08T19:53:34.217392"}, {"key": "yozilish_eslatma", "title": "Yozilish uchun eslatma", "text": "{ism}, \"{kurs}\" kursiga yozilishni eslab qo'ygan edik. Guruh {sana} boshlanadi. Yozilishni tasdiqlaysizmi?", "updated_at": "2026-11-08T19:53:34.217392"}, {"key": "qarz_eslatma", "title": "Qarz eslatma", "text": "{ism}, \"{kurs}\" kursi bo'yicha {summa} qarzingiz mavjud. To'lov uchun markazga murojaat qiling.", "updated_at": "2026-11-08T19:53:34.217392"}], "audit_log": [{"id": 1, "user": "admin", "entity": "backup", "entity_id": 0, "action": "yaratildi", "field": null, "old_value": null, "new_value": "backup-20261109-025606.json", "created_at": "2026-11-08T21:56:06.291481"}, {"id": 2, "user": "admin", "entity": "backup", "entity_id": 0, "action": "tiklandi", "field": null, "old_value": null, "new_value": "backup-20261109-025606.json (xavfsizlik nusxa: backup-20261109-025606.json)", "created_at": "2026-11-08T21:56:06.532504"}, {"id": 3, "user": "admin", "entity": "lead", "entity_id": 1, "action": "yaratildi", "field": null, "old_value": null, "new_value": "Haqiqiy Mijoz, +998938880011", "created_at": "2026-11-08T21:56:06.756325"}, {"id": 4, "user": "admin", "entity": "lead", "entity_id": 2, "action": "yaratildi", "field": null, "old_value": null, "new_value": "Test Mijoz, +998938880022", "created_at": "2026-11-08T21:56:06.786493"}, {"id": 5, "user": "admin", "entity": "lead", "entity_id": 2, "action": "ozgartirildi", "field": "test_belgisi", "old_value": "yo'q", "new_value": "ha", "created_at": "2026-11-08T21:56:06.816582"}, {"id": 6