pt", "text": "Har doim juda rasmiy va qisqa javob bering.", "updated_at": "2026-11-08T22:40:44.789635"}, {"key": "extra_knowledge", "text": "Sinov narxi: 1 so'm.", "updated_at": "2026-11-08T22:40:44.798886"}], "message_templates": [{"key": "sinov_taklif", "title": "Sinov darsiga taklif", "text": "{ism}, sizni \"{kurs}\" kursiga sinov darsiga taklif qilamiz! Sana va vaqtni kelishib olamiz — qiziqqan bo'lsangiz javob yozing.", "updated_at": "2026-11-08T19:53:34.217392"}, {"key": "narxlar", "title": "Narxlar", "text": "{ism}, \"{kurs}\" kursining oylik narxi {summa}. Qo'shimcha savollar bo'lsa bemalol yozing!", "updated_at": "2026-11-08T22:40:48.409855"}, {"key": "guruh_toldi", "title": "Guruh to'ldi", "text": "{ism}, afsuski \"{guruh}\" guruhi to'lgan. Sizni navbatga yozdik — o'rin bo'shash bilanoq xabar beramiz.", "updated_at": "2026-11-08T19:53:34.217392"}, {"key": "yozilish_eslatma", "title": "Yozilish uchun eslatma", "text": "{ism}, \"{kurs}\" kursiga yozilishni eslab qo'ygan edik. Guruh {sana} boshlanadi. Yozilishni tasdiqlaysizmi?", "updated_at": "2026-11-08T19:53:34.217392"}, {"key": "qarz_eslatma", "title": "Qarz eslatma", "text": "{ism}, \"{kurs}\" kursi bo'yicha {summa} qarzingiz mavjud. To'lov uchun markazga murojaat qiling.", "updated_at": "2026-11-08T19:53:34.217392"}], "audit_log": [{"id": 1, "user": "admin", "entity": "sozlama", "entity_id": 0, "action": "ozgartirildi", "field": "center_name", "old_value": null, "new_value": "INVENTOR TEST MARKAZ", "created_at": "2026-11-08T22:40:48.635082"}, {"id": 2, "user": "admin", "entity": "sozlama", "entity_id": 0, "action": "ozgartirildi", "field": "logo", "old_value": null, "new_value": "yuklandi", "created_at": "2026-11-08T22:40:48.699730"}, {"id": 3, "user": "admin", "entity": "sozlama", "entity_id": 0, "action": "ozgartirildi", "field": "center_name", "old_value": null, "new_value": "INVENTOR TEST MARKAZ", "created_at": "2026-11-08T22:40:48.708905"}, {"id": 4, "user": "admin", "entity": "sozlama", "entity_id